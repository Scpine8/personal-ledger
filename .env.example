# Personal ledger — copy to .env

# Required for mutating and querying APIs (not /health or /docs)
API_KEY=dev-local-key

# SQLite by default (local file). For a shared database, use a Neon pooled URL:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./data/ledger.sqlite

# Leave empty to run against the built-in mock institution (no Plaid account needed).
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_COUNTRY_CODES=US
PLAID_REDIRECT_URI=

# Optional shared secret for POST /v1/webhooks/plaid
WEBHOOK_SECRET=

HOST=0.0.0.0
PORT=8787
